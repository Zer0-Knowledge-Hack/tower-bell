{
  "expo": {
    "name": "Towerbell",
    "slug": "towerbell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050814"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.towerbell.local",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Towerbell uses location so nearby beacons can be found over Bluetooth.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Towerbell needs background location to keep discovering shops while you walk.",
        "NSLocationAlwaysUsageDescription": "Keep discovering nearby shops while Towerbell runs in the background.",
        "NSCameraUsageDescription": "Camera is used for optional peer video calls.",
        "NSMicrophoneUsageDescription": "Microphone is used for optional peer voice calls.",
        "NSBluetoothAlwaysUsageDescription": "Bluetooth finds shops and travelers around you without internet.",
        "NSBluetoothPeripheralUsageDescription": "Your shop beacon uses Bluetooth so travelers can see you nearby.",
        "NSPhotoLibraryUsageDescription": "Photos can be shared over the local P2P channel.",
        "NSPhotoLibraryAddUsageDescription": "Save files received from nearby peers.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-peripheral",
          "audio",
          "fetch",
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "app.towerbell.local",
      "adaptiveIcon": {
        "backgroundColor": "#050814",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/demo"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Towerbell uses location so nearby beacons can be found over Bluetooth.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#5CE1FF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Camera is used for optional peer video calls."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Microphone is used for optional peer voice calls."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Photos can be shared over the local P2P channel.",
          "savePhotosPermission": "Save files received from nearby peers."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7ba5731a-84fe-4ece-8be8-dfff32f8348b"
      }
    },
    "owner": "cisn3ronauta"
  }
}
