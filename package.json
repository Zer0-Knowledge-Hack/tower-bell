{
  "name": "towerbell",
  "productName": "towerbell",
  "version": "1.0.1",
  "description": "Hyperlocal P2P shop discovery: scan nearby beacons or broadcast your shop. No internet, no servers, no accounts.",
  "homepage": "https://tower-bell.vercel.app",
  "keywords": [
    "p2p",
    "hyperswarm",
    "pear",
    "holepunch",
    "hyperlocal",
    "bare",
    "towerbell",
    "zero-knolage"
  ],
  "private": true,
  "upgrade": "pear://xtj3nobayrtccxp68dnngayheeor3bc8kt8j4q19b3d5znrj1yqy",
  "bin": "bin.mjs",
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare test/index.js",
    "lint": "prettier . --check && lunte backend bin.mjs app.js scripts test workers",
    "start": "bare bin.mjs --no-updates",
    "scan": "bare bin.mjs --no-updates scan",
    "beacon": "bare bin.mjs --no-updates beacon",
    "scan:fake": "bare bin.mjs --no-updates --fake scan",
    "beacon:fake": "bare bin.mjs --no-updates --fake beacon",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --name towerbell --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --name towerbell --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --name towerbell --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --name towerbell --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --name towerbell --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --name towerbell --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "bare-events": "^2.9.1",
    "bare-fs": "^4.8.1",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-process": "^4.5.0",
    "bare-storage": "^1.1.0",
    "corestore": "^7.9.2",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperbee": "^2.27.3",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.2.0",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "bare-build": "^1.0.2",
    "bare-runtime": "1.29.4",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zer0-Knowledge-Hack/tower-bell.git"
  },
  "author": "Zero-Knolage",
  "license": "Apache-2.0"
}
