{
  "name": "towerbell",
  "productName": "towerbell",
  "version": "1.0.1",
  "description": "Hyperlocal P2P shop discovery: scan nearby beacons or broadcast your shop. No internet, no servers, no accounts.",
  "packageManager": "pnpm@10.34.5",
  "homepage": "https://tower-bell.vercel.app",
  "keywords": [
    "p2p",
    "hyperswarm",
    "pear",
    "holepunch",
    "hyperlocal",
    "bare",
    "towerbell",
    "zero-knolage"
  ],
  "private": true,
  "upgrade": "pear://xtj3nobayrtccxp68dnngayheeor3bc8kt8j4q19b3d5znrj1yqy",
  "bin": "bin.mjs",
  "pear": {
    "stage": {
      "ignore": [
        "/.git",
        "/.github",
        "/.gitattributes",
        "/.gitignore",
        "/.npmrc",
        "/.prettierignore",
        "/.prettierrc",
        "/out",
        "/test",
        "/scripts",
        "/docs",
        "/landing",
        "/public",
        "/CHANGELOG.md",
        "/LICENSE",
        "/NOTICE",
        "/README.md",
        "/AGENTS.md",
        "/FRONTEND_INTEGRATION.md",
        "/pnpm-lock.yaml",
        "/pnpm-workspace.yaml",
        "/towerbell-sistema-de-trabajodividido.md",
        "/frontend/App.js",
        "/frontend/app.json",
        "/frontend/assets",
        "/frontend/backend",
        "/frontend/docs",
        "/frontend/eas.json",
        "/frontend/index.js",
        "/frontend/LICENSE",
        "/frontend/package.json",
        "/frontend/package-lock.json",
        "/frontend/pnpm-lock.yaml",
        "/frontend/README.md",
        "/frontend/src",
        "/node_modules/@jridgewell",
        "/node_modules/@types",
        "/node_modules/bare-apk",
        "/node_modules/bare-build",
        "/node_modules/bare-build-android-arm",
        "/node_modules/bare-build-android-arm64",
        "/node_modules/bare-build-android-ia32",
        "/node_modules/bare-build-android-x64",
        "/node_modules/bare-build-darwin-arm64",
        "/node_modules/bare-build-darwin-x64",
        "/node_modules/bare-build-ios-arm64",
        "/node_modules/bare-build-ios-arm64-simulator",
        "/node_modules/bare-build-ios-x64-simulator",
        "/node_modules/bare-build-linux-arm64",
        "/node_modules/bare-build-linux-x64",
        "/node_modules/bare-build-win32-arm64",
        "/node_modules/bare-build-win32-x64",
        "/node_modules/bare-bundle-id",
        "/node_modules/bare-cov",
        "/node_modules/bare-crypto",
        "/node_modules/bare-debug-log",
        "/node_modules/bare-encoding",
        "/node_modules/bare-format",
        "/node_modules/bare-http1",
        "/node_modules/bare-http-parser",
        "/node_modules/bare-https",
        "/node_modules/bare-inspector",
        "/node_modules/bare-lief",
        "/node_modules/bare-link",
        "/node_modules/bare-net",
        "/node_modules/bare-pack",
        "/node_modules/bare-runtime",
        "/node_modules/bare-runtime-win32-x64",
        "/node_modules/bare-stylize",
        "/node_modules/bare-tls",
        "/node_modules/bare-tpl",
        "/node_modules/bare-unpack",
        "/node_modules/bare-utils",
        "/node_modules/bare-v8-to-istanbul",
        "/node_modules/bare-ws",
        "/node_modules/brittle",
        "/node_modules/convert-source-map",
        "/node_modules/error-stack-parser",
        "/node_modules/globbie",
        "/node_modules/lunte",
        "/node_modules/picomatch",
        "/node_modules/prettier",
        "/node_modules/prettier-config-holepunch",
        "/node_modules/promaphore",
        "/node_modules/same-object",
        "/node_modules/stackframe",
        "/node_modules/test-tmp",
        "/node_modules/tmatch",
        "/node_modules/v8-to-istanbul"
      ]
    }
  },
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare test/index.js",
    "lint": "prettier . --check && lunte backend bin.mjs app.js scripts test workers frontend/traveler.mjs frontend/trade.mjs frontend/style.mjs frontend/cli",
    "start": "bare bin.mjs --no-updates",
    "scan": "bare bin.mjs --no-updates scan",
    "beacon": "bare bin.mjs --no-updates beacon",
    "scan:fake": "bare bin.mjs --no-updates --fake scan",
    "beacon:fake": "bare bin.mjs --no-updates --fake beacon",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --name towerbell --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --name towerbell --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --name towerbell --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --name towerbell --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --name towerbell --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --name towerbell --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "bare-events": "^2.9.1",
    "bare-fs": "^4.8.1",
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-process": "^4.5.0",
    "bare-storage": "^1.1.0",
    "corestore": "^7.9.2",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperbee": "^2.27.3",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.2.0",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "bare-build": "^1.0.2",
    "bare-runtime": "1.29.4",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zer0-Knowledge-Hack/tower-bell.git"
  },
  "author": "Zero-Knolage",
  "license": "Apache-2.0"
}
