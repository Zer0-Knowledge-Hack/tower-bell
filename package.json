{
  "name": "towerbell",
  "productName": "towerbell",
  "version": "0.0.0-rc.0",
  "description": "Descubrimiento hiperlocal de comercios sin internet.",
  "private": true,
  "bin": "index.js",
  "upgrade": "pear://<YOUR_KEY_HERE>",
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare test/index.js",
    "lint": "prettier . --check && lunte",
    "start": "bare index.js --no-updates",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --name towerbell --standalone --host darwin-arm64 --out ./out/darwin-arm64 index.js",
    "make:darwin-x64": "bare-build --name towerbell --standalone --host darwin-x64 --out ./out/darwin-x64 index.js",
    "make:linux-arm64": "bare-build --name towerbell --standalone --host linux-arm64 --out ./out/linux-arm64 index.js",
    "make:linux-x64": "bare-build --name towerbell --standalone --host linux-x64 --out ./out/linux-x64 index.js",
    "make:win32-arm64": "bare-build --name towerbell --standalone --host win32-arm64 --out ./out/win32-arm64 index.js",
    "make:win32-x64": "bare-build --name towerbell --standalone --host win32-x64 --out ./out/win32-x64 index.js"
  },
  "dependencies": {
    "bare-os": "^3.9.0",
    "bare-path": "^3.0.0",
    "bare-process": "^4.5.0",
    "bare-storage": "^1.1.0",
    "bare-timers": "^3.0.0",
    "corestore": "^7.9.2",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hello-pear-worker": "^1.0.0",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.10.1",
    "pear-runtime": "^1.2.0",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "bare-build": "^1.0.2",
    "bare-runtime": "1.29.4",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zer0-Knowledge-Hack/tower-bell.git"
  },
  "license": "Apache-2.0"
}
